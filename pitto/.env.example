# PostgreSQL 接続先。Supabase を使う場合は Project Settings → Database の接続文字列。
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/pitto

# QRコードに埋め込む公開URLの起点。末尾スラッシュなし。
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# オーナー画面・管理画面のセッションCookieの署名鍵。32文字以上。
# 本番では必ず自分で生成する: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=change-me-to-a-random-string-at-least-32-chars

# --- Phase 2 以降で使用 ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
